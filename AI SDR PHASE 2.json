    {
      "parameters": {
        "jsCode": "const data = items[0].json.data;\nconst loopItem = $('Loop Over Items').item.json;\n\n// Try to get email from Hunter results\nlet contactEmail = '';\nif (data.emails && data.emails.length > 0) {\n  contactEmail = data.emails[0].value;\n} else {\n  // Fall back to linked domain or original domain\n  const domain = data.linked_domains && data.linked_domains.length > 0 \n    ? data.linked_domains[0] \n    : data.domain;\n  contactEmail = 'hello@' + domain;\n}\n\nreturn [{\n  json: {\n    ...loopItem,\n    contactEmail: contactEmail,\n    emailFound: data.emails && data.emails.length > 0\n  }\n}];"
      },

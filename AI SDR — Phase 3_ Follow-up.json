    {
      "parameters": {
        "jsCode": "const now = new Date();\n\nreturn items.filter(item => {\n  const status = item.json.status;\n  const emailSent = item.json.emailSent;\n  const followUpSent = item.json.followUpSent;\n\n  // Must have been contacted\n  if (status !== 'contacted') return false;\n  \n  // Must not have already received a follow-up\n  if (followUpSent && followUpSent !== '') return false;\n  \n  // Must have been sent more than 3 days ago\n  if (!emailSent || emailSent === '') return false;\n  \n  const sentDate = new Date(emailSent);\n  const daysDiff = (now - sentDate) / (1000 * 60 * 60 * 24);\n  \n  return daysDiff >= 3;\n});"
      },

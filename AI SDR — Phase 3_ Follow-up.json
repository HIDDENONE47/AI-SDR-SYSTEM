        "jsonBody": "={\n  \"model\": \"llama-3.3-70b-versatile\",\n  \"max_tokens\": 500,\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a B2B sales development rep writing a short follow-up email. The prospect hasn't replied to the first email. Write a brief, friendly follow-up under 80 words. No fluff. Reference their product specifically. End with a simple question.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"={{ 'Company: ' + $json.companyName + '\\\\nWhat they do: ' + $json.whatTheyDo + '\\\\nOriginal email sent: ' + $json.emailBody + '\\\\nWrite a short follow-up email.' }}\"\n    }\n  ]\n}",

    {
      "parameters": {
        "jsCode": "const content = items[0].json.choices[0].message.content;\n\n// Strip markdown backticks and parse JSON\nconst cleaned = content.replace(/```json\\n?/g, '').replace(/```/g, '').trim();\nconst parsed = JSON.parse(cleaned);\n\n// Carry forward the realUrl from the previous code node\nconst realUrl = $('Code in JavaScript1').item.json.realUrl;\n\nreturn [{\n  json: {\n    companyName: parsed.companyName,\n    whatTheyDo: parsed.whatTheyDo,\n    targetCustomer: parsed.targetCustomer,\n    painPoint: parsed.painPoint,\n    opportunityAngle: parsed.opportunityAngle,\n    emailSubject: parsed.emailSubject,\n    emailBody: parsed.emailBody,\n    realUrl: realUrl,\n    status: 'enriched',\n    dateProcessed: new Date().toISOString()\n  }\n}];"
      },

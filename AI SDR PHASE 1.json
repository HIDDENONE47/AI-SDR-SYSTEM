        "jsCode": "const edges = items[0].json.data.posts.edges;\n\nreturn edges.map(edge => ({\n  json: {\n    name: edge.node.name,\n    tagline: edge.node.tagline,\n    description: edge.node.description,\n    votes: edge.node.votesCount,\n    redirectUrl: edge.node.website\n  }\n}));"

    {
      "parameters": {
        "jsCode": "const html = items[0].json.data;\nconst name = items[0].json.name || $('Loop Over Items').item.json.name;\n\n// Extract URL from canonical link or og:url\nconst urlMatch = html.match(/rel=\"canonical\" href=\"([^\"]+)\"/) || \n                 html.match(/og:url\" content=\"([^\"]+)\"/);\nconst realUrl = urlMatch ? urlMatch[1] : 'unknown';\n\n// Extract title\nconst titleMatch = html.match(/<title>([^<]+)<\\/title>/);\nconst title = titleMatch ? titleMatch[1] : '';\n\n// Extract meta description\nconst descMatch = html.match(/name=\"description\" content=\"([^\"]+)\"/) ||\n                  html.match(/og:description\" content=\"([^\"]+)\"/);\nconst metaDesc = descMatch ? descMatch[1] : '';\n\n// Strip all HTML tags, collapse whitespace, take first 2000 chars\nconst bodyText = html\n  .replace(/<script[^>]*>[\\s\\S]*?<\\/script>/gi, '')\n  .replace(/<style[^>]*>[\\s\\S]*?<\\/style>/gi, '')\n  .replace(/<[^>]+>/g, ' ')\n  .replace(/\\s+/g, ' ')\n  .trim()\n  .substring(0, 2000);\n\n// Carry forward previous fields from the loop\nconst loopItem = $('Loop Over Items').item.json;\n\nreturn [{\n  json: {\n    name: loopItem.name,\n    tagline: loopItem.tagline,\n    description: loopItem.description,\n    realUrl: realUrl,\n    pageTitle: title,\n    metaDescription: metaDesc,\n    bodyText: bodyText\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        288,

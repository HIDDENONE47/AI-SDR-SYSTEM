        "jsonBody": "={\n  \"model\": \"llama-3.3-70b-versatile\",\n  \"max_tokens\": 100,\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a sales assistant. Classify the following email reply into exactly one of these categories: INTERESTED, NOT_INTERESTED, NEEDS_MORE_INFO, OUT_OF_OFFICE, OTHER. Reply with only the category word, nothing else.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"={{ $json.snippet }}\"\n    }\n  ]\n}",
        "options": {}
      },
